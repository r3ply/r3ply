{
  "name": "@r3ply/docs",
  "version": "0.0.1",
  "description": "r3ply site and documentation",
  "private": true,
  "scripts": {
    "copy:schemas": "cp -r ../packages/schema/dist/schemas static/",
    "build": "zola build $BUILD_OPTS && npx @tailwindcss/cli -i ./css/input.css -o ./public/style.css -m",
    "serve": "zola serve $SERVE_OPTS & npx @tailwindcss/cli  -i ./css/input.css -o ./public/style.css --watch && wait",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "volta": {
    "node": "22.9.0"
  },
  "author": "Spencer Scorcelletti",
  "license": "MIT",
  "devDependencies": {
    "@r3ply/schema": "workspace:*",
    "@tailwindcss/cli": "^4.1.16",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^4.1.12"
  },
  "dependencies": {
    "fuse.js": "^7.1.0"
  }
}
