{
  "name": "r3ply",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "initialize": "git submodule update --init --remote --recursive",
    "fmt": "prettier --write \"**/*.{js,cjs,ts,mts,jsx,tsx,json,toml}\"",
    "build:wasm": "pnpm --filter @r3ply/wasm run build:wasm && pnpm --filter @r3ply/wasm run pack",
    "build:pkgs": "pnpm -r --filter './packages/*' run build",
    "build:apps": "pnpm -r --filter './apps/*' run build",
    "build:site": "pnpm initialize && pnpm -r --filter '@r3ply/schema' run build && pnpm -r --filter './site' run copy:schemas && pnpm -r --filter './site' run build",
    "build:all": "pnpm build:wasm && pnpm build:pkgs && pnpm build:apps && pnpm build:site",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:all": "pnpm -r test",
    "site": "pnpm initialize && pnpm -r --filter './site' run serve"
  },
  "pnpm": {
    "overrides": {},
    "supportedArchitectures": {
      "os": ["current", "linux"],
      "cpu": ["current", "x64"]
    }
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-toml": "^2.0.2",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "22.9.0"
  },
  "packageManager": "pnpm@10.11.1"
}
