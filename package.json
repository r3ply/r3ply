{
  "name": "r3ply",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "pnpm --filter @r3ply/wasm run build:wasm && pnpm --filter @r3ply/wasm run pack",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "build:apps": "pnpm -r --filter './apps/*' run build",
    "build:all": "pnpm build:wasm && pnpm build:packages && pnpm build:apps",
    "test:ts": "pnpm -r --filter './packages/*' --filter './apps/*' test"
  },
  "pnpm": {
    "overrides": {
      "@r3ply/cli": "link:packages/cli"
    }
  },
  "dependencies": {
    "@r3ply/cli": "link:packages/cli"
  }
}